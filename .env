# Секретный ключ для генерации и валидации JWT токенов
JWT_SECRET=test-secret-key-super-secret-123

# Стучимся на localhost:5433 (порт, который проброшен из докера наружу)
SERVICE_TEST_POSTGRES_DSN=postgres://users_db:users_db@127.0.0.1:5433/users_db?sslmode=disable

# Адреса всех трех мастеров Redis (проброшенные порты 7001, 7002, 7003)
SERVICE_TEST_REDIS_ADDR=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

# Адреса всех трех брокеров Kafka (проброшенные порты 9091, 9092, 9093)
SERVICE_TEST_KAFKA_BROKERS=127.0.0.1:9091,127.0.0.1:9092,127.0.0.1:9093

POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/user_db?sslmode=disable

POSTGRES_IT_TEST_DSN=postgres://users_db:users_db@127.0.0.1:5433/users_db?sslmode=disable
