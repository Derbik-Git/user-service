# ==========================================
# КОНФИГУРАЦИЯ ДЛЯ ИНТЕГРАЦИОННЫХ ТЕСТОВ
# ==========================================

JWT_SECRET=test-secret-key-super-secret-123

# Если запуск идет внутри Docker, используйте имя сервиса pgbouncer. 
# Порт 6432 — стандартный внутренний/внешний порт пуллера.
SERVICE_TEST_POSTGRES_DSN=postgres://users_db:users_db@pgbouncer:6432/users_db?sslmode=disable&prefer_simple_protocol=true

# Все 6 нод Redis кластера
SERVICE_TEST_REDIS_ADDR=redis-1:7001,redis-2:7002,redis-3:7003,redis-4:7004,redis-5:7005,redis-6:7006

# Брокеры Kafka
SERVICE_TEST_KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

POSTGRES_MASTER_DSN=postgres://users_db:users_db@pgbouncer:6432/users_db?sslmode=disable&prefer_simple_protocol=true

POSTGRES_SLAVE_DSN=postgres://users_db:users_db@postgres-replica:5432/users_db?sslmode=disable

